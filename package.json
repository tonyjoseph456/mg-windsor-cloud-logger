{
  "name": "mg-ismart-india-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MG iSMART India Connected Vehicle Companion App (iOS PWA + React Native Expo + Pure TypeScript ASN.1/TAP SDK)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "node --import tsx --test src/sdk/__tests__/*.test.ts",
    "proxy": "node --import tsx server/cors-proxy.ts"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
